# ─────────────────────────────────────────────────────────────────
# LOJA FERNANDO QUINCAS — VARIÁVEIS DE AMBIENTE
# Configure na Vercel (Project → Settings → Environment Variables)
# ou num arquivo .env local para usar com `vercel dev`.
# NUNCA comite valores reais deste arquivo.
# ─────────────────────────────────────────────────────────────────

# ── BANCO DE DADOS (produção) ──
# Postgres serverless — Neon via Vercel Marketplace é o caminho recomendado.
# Sem esta variável, os pedidos rodam em MODO DEMONSTRAÇÃO em memória
# (não persistem entre invocações — sinalizado na interface).
DATABASE_URL=

# ── MERCADO PAGO (pagamentos reais) ──
# Credencial PRIVADA de produção (prefixo APP_USR-...).
# Painel: https://www.mercadopago.com.br/panel → Suas integrações → Credenciais.
# Sem ela, o checkout retorna "pagamento temporariamente indisponível".
MERCADOPAGO_ACCESS_TOKEN=

# Chave PÚBLICA do Mercado Pago (para uso futuro de tokenização de cartão no frontend).
MERCADOPAGO_PUBLIC_KEY=

# Chave secreta do WEBHOOK para validar o header x-signature das notificações.
# Mesma tela de credenciais → Edificar webhook → chave secreta. Fortemente recomendado.
MERCADOPAGO_WEBHOOK_SECRET=

# URL pública do site — usada nas back_urls e notification_url enviadas ao gateway.
APP_URL=https://fernandoquincas.com.br

# ── E-MAILS TRANSACIONAIS (opcional hoje, arquitetura pronta) ──
# https://resend.com — sem estas chaves, os e-mails viram no-op em log.
RESEND_API_KEY=
EMAIL_FROM="Ateliê Fernando Quincas <byfernandoscenesgarden@gmail.com>"
ATELIER_EMAIL=byfernandoscenesgarden@gmail.com
