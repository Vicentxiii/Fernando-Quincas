{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "trustedDependencies": ["@google/genai", "esbuild", "protobufjs"],
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && tsx scripts/prerender.ts && tsx scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "indexnow": "tsx scripts/submit-indexnow.ts --all",
    "indexnow:dry": "tsx scripts/submit-indexnow.ts --all --dry-run",
    "indexnow:changed": "tsx scripts/submit-indexnow.ts",
    "audit": "tsx scripts/audit/run-cart.ts && tsx scripts/audit/run-prices.ts && tsx scripts/audit/run-stock.ts && tsx scripts/audit/run-webhook.ts && tsx scripts/audit/run-prod-security.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.5",
    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "mercadopago": "^3.4.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/three": "^0.185.4",
    "@vercel/node": "^7.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
